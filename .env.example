# ---- Backend (Spring Boot) ----
DB_URL=jdbc:postgresql://localhost:5432/devcollab
DB_USER=devcollab
DB_PASSWORD=devcollab

REDIS_HOST=localhost
REDIS_PORT=6379

# Must be >= 32 bytes for HS256. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Auth cookies — for cross-site production over HTTPS use COOKIE_SECURE=true
# and COOKIE_SAME_SITE=None. Local dev defaults are fine.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Email verification — works with ANY SMTP relay (Resend / Brevo / SendGrid /
# Mailgun / Amazon SES / Outlook …) and delivers to any recipient inbox.
# Leave unset to log codes to the console in dev (no email sent).
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=DevCollab <no-reply@yourdomain.com>
VERIFICATION_TTL=600
VERIFICATION_MAX_ATTEMPTS=5

# GitHub OAuth — create an OAuth App at github.com/settings/developers
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase Storage (Phase 2 file uploads) — S3-compatible endpoint
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=devcollab
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
